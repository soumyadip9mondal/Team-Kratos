// ENUMS
// MODELS
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      String  @id @default(uuid())
  name                    String
  domain                  String? @unique
  planTier                String  @default("Free")
  notificationPreferences Json?

  // Company Details & Statutory Info
  pan      String?
  gstin    String?
  cin      String?
  industry String?
  size     String?
  founded  String?
  address  String?
  city     String?
  state    String?
  pincode  String?
  country  String?

  // Organizational Structure
  departments String[]
  customRoles Json? // Stores the array of roles [{name, level, locked, canManage, description}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  attendances      Attendance[]
  leaves           Leave[]
  payrolls         Payroll[]
  payrollConfigs   PayrollConfig[]
  auditLogs        AuditLog[]
  adminEmails      AdminEmail[]
  invitedEmployees InvitedEmployee[]
  salaryAdvances   SalaryAdvance[]
  announcements    Announcement[]
  birthdayWishes   BirthdayWish[]
  userPreferences  UserPreference[]
  shiftRosters     ShiftRoster[]
  shiftSlots       ShiftSlot[]
  shiftAssignments ShiftAssignment[]
  benefitPlans     BenefitPlan[]
  employeeBenefits EmployeeBenefit[]

  legalEntities        LegalEntity[]
  subscriptions        Subscription[]
  usageRecords         UsageRecord[]
  complianceRules      ComplianceRule[]
  strategicActionPlans StrategicActionPlan[]
  importJobs           ImportJob[]
  webhookSubscriptions WebhookSubscription[]
  apiKeys              ApiKey[]
  colocationGraphCache ColocationGraphCache?

  offices                          Office[]
  leavePolicies                    LeavePolicy[]
  shiftPolicies                    ShiftPolicy[]
  onboardingChecklists             OnboardingChecklist[]
  onboardingTasks                  OnboardingTask[]
  onboardingChecklistTemplates     OnboardingChecklistTemplate[]
  onboardingChecklistTemplateTasks OnboardingChecklistTemplateTask[]
  onboardingDocuments              OnboardingDocument[]
  onboardingDocumentRequirements   OnboardingDocumentRequirement[]
  goals                            Goal[]
  reviews                          Review[]

  intelligenceProfiles   IntelligenceProfile[]
  intelligenceSignals    IntelligenceSignal[]
  workforceMetrics       WorkforceMetric[]
  scenarioAudits         ScenarioAudit[]
  feedbacks360           Feedback360[]
  tickets                Ticket[]
  expenseClaims          ExpenseClaim[]
  documentTemplates      DocumentTemplate[]
  generatedDocuments     GeneratedDocument[]
  signatureRequests      SignatureRequest[]
  proxyAlerts            ProxyAlert[]
  investigationReports   InvestigationReport[]
  jobRequisitions        JobRequisition[]
  candidates             Candidate[]
  applications           Application[]
  atsResults             ATSResult[]
  atsEmbeddings          ATSEmbedding[]
  assets                 Asset[]
  assetAssignments       AssetAssignment[]
  projects               Project[]
  timesheetEntries       TimesheetEntry[]
  oneOnOnes              OneOnOne[]
  pulseSurveys           PulseSurvey[]
  pulseResponses         PulseResponse[]
  hrDocuments            HRDocument[]
  chatSessions           ChatSession[]
  roleDefinitions        RoleDefinition[]
  onboardingReminderDays Int                   @default(3)
  faceRegistrations      FaceRegistration[]
  candidateRankings      CandidateRanking[]
  RosterSimulation       RosterSimulation[]

  // AI Operating Layer
  outboxEvents  OutboxEvent[]
  irisTasks     IrisTask[]
  irisApprovals IrisApproval[]
  appNotifications AppNotification[]

  communicationReviewConfig   CommunicationReviewConfig?
  communicationPersonas       CommunicationPersona[]
  communicationStressTests    CommunicationStressTest[]
}

model RoleDefinition {
  id               String   @id @default(uuid())
  tenantId         String?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id])
  name             String
  level            Int
  isOwnerRole      Boolean  @default(false)
  isSystemDefault  Boolean  @default(false)
  canAccessConsole Boolean  @default(false)
  permissions      Json?
  createdById      String?
  createdBy        User?    @relation("RoleCreator", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users User[]
}

enum Status {
  Active
  Inactive
  OnLeave
}

model Office {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  lat          Float
  lng          Float
  radiusMeters Float    @default(500)
  address      String?
  state        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  attendances Attendance[]
}

model ShiftPolicy {
  id                     String   @id @default(uuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id])
  name                   String
  startTime              String
  endTime                String
  gracePeriodMinutes     Int      @default(15)
  graceMinutes           Int      @default(15)
  breakDurationMinutes   Int      @default(60)
  overtimeRateMultiplier Float    @default(1.5)
  lateDeductionPerMinute Float    @default(0)
  minOvertimeMinutes     Int      @default(30)
  assignmentDays         Int? // How many days before auto-removal
  color                  String   @default("#6366f1")
  isArchived             Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users   User[]
  rosters ShiftRoster[]
}

model ShiftRoster {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  shiftPolicyId String?
  shiftPolicy   ShiftPolicy? @relation(fields: [shiftPolicyId], references: [id])
  date          DateTime
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([tenantId, userId, date])
  @@index([tenantId, date])
}

model ShiftSlot {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  date        DateTime          @db.Date
  shiftType   String // "MORNING" | "EVENING" | "NIGHT"
  startTime   String // "06:00"
  endTime     String // "14:00"
  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  slotId     String
  employeeId String
  mode       String // "AUTO" | "MANUAL"
  assignedBy String? // userId — null if AUTO
  createdAt  DateTime @default(now())

  slot     ShiftSlot @relation(fields: [slotId], references: [id])
  employee User      @relation(fields: [employeeId], references: [id])

  @@unique([slotId, employeeId])
}

model LeavePolicy {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  name                 String
  policyGroupId        String?  @default(uuid())
  annualQuota          Decimal
  carryForward         Boolean  @default(false)
  maxCarryForward      Decimal?
  isPaid               Boolean  @default(true)
  allowNegativeBalance Boolean  @default(false)
  requiresAttachment   Boolean  @default(false)
  isArchived           Boolean  @default(false)
  effectiveFrom        DateTime @default(now())
  leaveYearStartMonth  Int      @default(1)
  leaveYearStartDay    Int      @default(1)
  createdAt            DateTime @default(now())

  leaves Leave[]
}

enum LeaveLedgerReason {
  ANNUAL_GRANT
  ACCRUAL
  CARRY_FORWARD
  YEAR_END_LAPSE
  LEAVE_TAKEN
  PENDING_HOLD
  REVERSAL
  ADJUSTMENT
  ENCASHMENT
}

model LeaveLedgerEntry {
  id              String            @id @default(cuid())
  tenantId        String
  userId          String
  policyGroupId   String
  amount          Decimal
  reason          LeaveLedgerReason
  leaveRequestId  String?
  reversedEntryId String?
  notes           String?

  reversedEntry LeaveLedgerEntry?  @relation("ReversedEntry", fields: [reversedEntryId], references: [id])
  reversals     LeaveLedgerEntry[] @relation("ReversedEntry")

  createdAt DateTime @default(now())

  @@index([tenantId, userId, policyGroupId])
}

model User {
  id                 String          @id @default(uuid())
  tenantId           String?
  tenant             Tenant?         @relation(fields: [tenantId], references: [id])
  entityId           String?
  legalEntity        LegalEntity?    @relation(fields: [entityId], references: [id])
  officeId           String?
  office             Office?         @relation(fields: [officeId], references: [id])
  shiftPolicyId      String?
  shiftPolicy        ShiftPolicy?    @relation(fields: [shiftPolicyId], references: [id])
  employeeId         String?
  appNotifications   AppNotification[] @relation("UserNotifications")
  email              String          @unique
  password           String
  roleDefinitionId   String?
  roleDefinition     RoleDefinition? @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)
  customRole         String? // Tenant-specific organizational role label (e.g. "Team Lead") set by chairman
  mustChangePassword Boolean         @default(true)
  status             Status          @default(Active)

  emailVerified          Boolean   @default(false)
  otpCode                String?
  otpExpiry              DateTime?
  resetPasswordOtp       String?
  resetPasswordOtpExpiry DateTime?

  inviteToken           String?   @unique
  inviteTokenExpiry     DateTime?
  faceRegistered        Boolean   @default(false)
  biometricUnlocked     Boolean   @default(false) // one-time admin unlock token
  biometricUnlockExpiry DateTime? // token auto-expires at this time (48h TTL)

  displayName     String?
  avatar          String?
  department      String?
  jobPosition     String?
  managerId       String?
  manager         User?    @relation("UserManager", fields: [managerId], references: [id])
  subordinates    User[]   @relation("UserManager")
  about           String?
  skills          String[]
  certifications  String[]
  phone           String?
  residingAddress String?
  personalEmail   String?
  gender          String?
  nationality     String?
  maritalStatus   String?
  location        String?

  companyName String?
  companyLogo String?

  bankName      String?
  bankBranch    String?
  accountNumber String?
  ifscCode      String?
  panNo         String?
  aadharNo      String?
  aadharLast4   String?
  voterIdNo     String?

  aadharDoc       String?
  panDoc          String?
  voterDoc        String?
  addressProofDoc String?

  uanNo         String?
  empCode       String?
  dateOfBirth   DateTime?
  dateOfJoining DateTime? @default(now())

  workingDaysPerWeek Int   @default(6)
  breakTimeHrs       Float @default(1)
  baseSalary         Float @default(0)

  attritionRiskScore Float?
  attritionRiskLabel String?
  riskUpdatedAt      DateTime?

  onboardingStep      String  @default("personal_details")
  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances         Attendance[]
  leaves              Leave[]
  payrolls            Payroll[]
  advances            SalaryAdvance[]
  assetAssignments    AssetAssignment[]
  timesheetEntries    TimesheetEntry[]
  tickets             Ticket[]
  goals               Goal[]
  reviewsGiven        Review[]             @relation("Reviewer")
  reviewsReceived     Review[]             @relation("Reviewee")
  feedbackProvided    Feedback360[]        @relation("FeedbackProvider")
  feedbackReceived    Feedback360[]        @relation("FeedbackReceiver")
  onboardingTasks     OnboardingTask[]
  onboardingDocuments OnboardingDocument[]
  createdRoles        RoleDefinition[]     @relation("RoleCreator")
  birthdayWishes      BirthdayWish[]       @relation("BirthdayWisher")
  userPreference      UserPreference?
  adminAnnouncements  Announcement[]       @relation("AdminAnnouncements")
  shiftRosters        ShiftRoster[]
  shiftAssignments    ShiftAssignment[]
  expensesSubmitted   ExpenseClaim[]       @relation("ExpenseUser")
  expensesApproved    ExpenseClaim[]       @relation("ExpenseApprover")
  documentsReceived   GeneratedDocument[]  @relation("GeneratedDocumentUser")
  documentsGenerated  GeneratedDocument[]  @relation("GeneratedDocumentCreator")
  employeeBenefits    EmployeeBenefit[]    @relation("EmployeeBenefits")
  faceRegistration    FaceRegistration?
  assets              Asset[]
  createdJobs         JobRequisition[]     @relation("JobCreator")

  employeeOneOnOnes OneOnOne[]    @relation("EmployeeOneOnOnes")
  managerOneOnOnes  OneOnOne[]    @relation("ManagerOneOnOnes")
  chatSessions      ChatSession[]

  intelligenceProfile IntelligenceProfile?
  intelligenceSignals IntelligenceSignal[]

  createdPersonas     CommunicationPersona[] @relation("PersonaCreator")

  @@unique([tenantId, employeeId])
}

enum AttendanceStatus {
  Present
  Absent
  HalfDay
  OnLeave
}

model Attendance {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  officeId   String?
  office     Office?          @relation(fields: [officeId], references: [id])
  date       DateTime         @db.Date
  checkIn    DateTime
  checkOut   DateTime?
  workHours  Float            @default(0)
  extraHours Float            @default(0)
  breakHours Float            @default(1)
  status     AttendanceStatus @default(Present)

  latitude              Float?
  longitude             Float?
  accuracy              Float?
  trustScore            Int?
  verificationMethod    String?
  isLivenessVerified    Boolean @default(false)
  livenessEmbeddingHash String?
  isFlagged             Boolean @default(false)
  flagReason            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, date])
  @@index([tenantId, userId, date])
}

enum DurationType {
  FullDay
  HalfDay
  Hourly
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
}

model Leave {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  leavePolicyId  String
  leavePolicy    LeavePolicy  @relation(fields: [leavePolicyId], references: [id])
  durationType   DurationType @default(FullDay)
  hoursRequested Float?
  startDate      DateTime
  endDate        DateTime
  reason         String
  attachment     String?
  status         LeaveStatus  @default(Pending)
  adminRemarks   String?
  approvedById   String?
  approvedAt     DateTime?
  managerId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

model Payroll {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  entityId          String?
  legalEntity       LegalEntity? @relation(fields: [entityId], references: [id])
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  month             String
  monthWage         Float
  payableDays       Int
  basicSalary       Float
  hra               Float
  standardAllowance Float        @default(4167.00)
  performanceBonus  Float
  lta               Float
  pfEmployee        Float
  pfEmployer        Float
  professionalTax   Float        @default(200.00)
  fixedAllowance    Float

  overtimeHours      Float @default(0)
  overtimeBonus      Float @default(0)
  lateDeductions     Float @default(0)
  advanceDeduction   Float @default(0)
  expenseReimburse   Float @default(0)
  deductionBreakdown Json?
  bonusBreakdown     Json?

  benefitsDeduction Decimal @default(0.00) @db.Decimal(10, 2)
  benefitsBreakdown Json?

  grossSalary Float
  netSalary   Float
  locked      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, month])
}

model PayrollConfig {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  companyName         String
  pfEmployeePercent   Float    @default(12.0)
  pfEmployerPercent   Float    @default(12.0)
  professionalTax     Float    @default(200.0)
  standardAllowance   Float    @default(4167.0)
  basicPercentOfWage  Float    @default(50.0)
  hraPercentOfBasic   Float    @default(50.0)
  bonusPercentOfBasic Float    @default(8.33)
  ltaPercentOfBasic   Float    @default(8.33)
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, companyName])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  actorId   String
  action    String
  targetId  String?
  details   Json?
  prevHash  String?
  hash      String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model AdminEmail {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
}

model InvitedEmployee {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  email            String
  department       String?
  branch           String?
  roleDefinitionId String?
  createdAt        DateTime @default(now())

  @@unique([tenantId, email])
}

enum AdvanceStatus {
  Pending
  Approved
  Rejected
  Deducted
}

model SalaryAdvance {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Float
  reason         String
  monthDeduction String
  status         AdvanceStatus @default(Pending)

  riskScore  Int?
  riskLabel  String?
  approvedBy String?
  approvedAt DateTime?
  rejectedBy String?
  rejectedAt DateTime?
  deducted   Boolean   @default(false)
  deductedAt DateTime?
  settledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

enum ExpenseCategory {
  Travel
  Meals
  Supplies
  Software
  Utilities
  Training
  Other
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  SETTLED
}

enum AnnouncementCategory {
  General
  Policy
  Event
  Birthday
  Urgent
}

model Announcement {
  id        String               @id @default(uuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  adminId   String?
  admin     User?                @relation("AdminAnnouncements", fields: [adminId], references: [id])
  title     String               @default("Announcement")
  category  AnnouncementCategory @default(General)
  message   String
  createdAt DateTime             @default(now())

  wishes BirthdayWish[]

  stressTestId      String?  @unique
  stressTestVariant String?

  @@index([tenantId, createdAt])
}

model BirthdayWish {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  wisherId       String
  wisher         User         @relation("BirthdayWisher", fields: [wisherId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([announcementId, wisherId])
  @@index([tenantId, announcementId])
}

model UserPreference {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  announceBirthday Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LegalEntity {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  pfCode    String?
  ptRegNo   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  payrolls Payroll[]

  @@unique([tenantId, name])
}

model WorkflowState {
  id              String   @id @default(uuid())
  tenantId        String
  workflowId      String
  nodeId          String
  data            Json     @default("{}")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId, workflowId])
}

model AppNotification {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String?
  message   String?
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Subscription {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  razorpayPlanId String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UsageRecord {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  month           String
  activeEmployees Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, month])
}

model ComplianceRule {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  state         String
  ruleType      String
  effectiveFrom DateTime
  rateTable     Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ImportJob {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  status        String   @default("pending")
  sourceFile    String
  mappingConfig Json?
  errorLog      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  eventType String
  targetUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model OnboardingChecklist {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  createdAt DateTime @default(now())
}

model OnboardingTask {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  checklistId String?
  title       String
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
}

model OnboardingChecklistTemplate {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  department String?
  createdAt  DateTime @default(now())

  tasks OnboardingChecklistTemplateTask[]
}

model OnboardingChecklistTemplateTask {
  id            String                      @id @default(uuid())
  tenantId      String
  tenant        Tenant                      @relation(fields: [tenantId], references: [id])
  templateId    String
  template      OnboardingChecklistTemplate @relation(fields: [templateId], references: [id])
  title         String
  dueOffsetDays Int                         @default(0)
  createdAt     DateTime                    @default(now())
}

model OnboardingDocument {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  type                String    // e.g., 'IDENTITY_PROOF', 'ADDRESS_PROOF', 'EDUCATION_CERTIFICATE', 'EMPLOYMENT_PROOF', 'PAN', 'AADHAAR'
  fileId              String
  version             Int       @default(1)
  status              String    @default("UPLOADED") // UPLOADED, PROCESSING, EXTRACTED, VERIFIED, REQUIRES_REVIEW, REJECTED, EXPIRED
  extractedData       Json?     // PII-masked evidence (no raw full government IDs stored)
  confidence          Float?
  warnings            String[]
  evidenceFingerprint String?   // SHA-256 fingerprint for version-aware explainability
