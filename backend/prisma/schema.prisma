  id               String @id @default(uuid())
  tenantId         String
  tenant           Tenant @relation(fields: [tenantId], references: [id])
  metricSnapshotId String @unique // Determinstic snapshot identifier (e.g., wm_tenantId_metric_scope_entityId_period)

  metric   String // OVERTIME_COST, ATTENDANCE_PERCENT, PAYROLL_TOTAL, etc.
