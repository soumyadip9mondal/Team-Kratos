  aggregationMethod String? // SUM, AVG, MEDIAN
  dataCompleteness  Float? // 0.0 to 1.0 (how much raw data was available)

  baseline     Float?
  delta        Float?
  deltaPercent Float?

  confidence     Float                @default(1.0)
  classification MetricClassification
  source         String // PAYROLL, ATTENDANCE, RECRUITMENT
  calculatedAt   DateTime             @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, metric, period])
  @@index([tenantId, scope, entityId])
}

model ScenarioAudit {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  scenarioId         String   @unique
  createdBy          String // userId
  action             String // e.g., ADD_HEADCOUNT, REDUCE_OVERTIME
  parameters         Json // e.g., { departmentId: "eng", count: 3 }
  inputMetricVersion String // e.g., "2026-08-19"
  assumptions        Json // e.g., { OVERTIME_REDUCTION: 0.19 }
  result             Json // e.g., { PROJECTED_PAYROLL_DELTA: 210000 }
  createdAt          DateTime @default(now())

  @@index([tenantId, createdBy])
}

model RosterSimulation {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  status              String    @default("GENERATED") // GENERATED, APPLIED, STALE, EXPIRED, CANCELLED
  generatedAt         DateTime  @default(now())
  expiresAt           DateTime
  currentFingerprint  String
  proposedFingerprint String?
  plan                Json
  metrics             Json
  createdBy           String
  appliedAt           DateTime?
  appliedBy           String?

  @@index([tenantId, createdBy])
}

model StrategicActionPlan {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  goal       String // Human-readable goal e.g. "Reduce overtime by 15% this month"
  status     String    @default("PROPOSED") // PROPOSED, APPROVED, REJECTED, EXECUTED, FAILED
  plan       Json // The actual steps/mutations generated by the Orchestrator
  metrics    Json // The simulated impact metrics (e.g. { overtimeReduction: "15%", costSavings: "$4,500" })
  createdBy  String // "IRIS" or userId
  approvedBy String? // Admin who clicked "Approve"
  executedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, status])
}

// ── AI Operating Layer ──────────────────────────────────────────────────────

model OutboxEvent {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  eventType      String
  sourceEntity   String
  sourceEntityId String
  payload        Json
  idempotencyKey String
  status         String    @default("PENDING") // PENDING, PROCESSED, FAILED
  retryCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
}

model IrisTask {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  sourceEventId String   @unique
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recommendation IrisRecommendation?
  approval       IrisApproval?

  @@index([tenantId, status])
}

model IrisRecommendation {
  id                String   @id @default(uuid())
  taskId            String   @unique
  task              IrisTask @relation(fields: [taskId], references: [id])
  type              String
  evidence          Json
  recommendedAction String
  actionType        String
  actionParameters  Json
  dataFingerprint   String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
}

model IrisApproval {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  taskId              String   @unique
  task                IrisTask @relation(fields: [taskId], references: [id])
  approvedBy          String
  approvedAt          DateTime @default(now())
  actionType          String
  proposalFingerprint String
}

// ── Communication Stress Testing ────────────────────────────

enum SourceType {
  ANNOUNCEMENT
  TEAM_MESSAGE
}

enum TestStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  INCOMPLETE
  EXPIRED
  REDACTED
}

enum FrictionBand {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model CommunicationReviewConfig {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  enabled               Boolean  @default(false)
  policyContextEnabled  Boolean  @default(false)
  personaBuilderEnabled Boolean  @default(false)
  analyticsEnabled      Boolean  @default(false)
  detailRetentionDays   Int      @default(90)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CommunicationPersona {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  key         String
  name        String
  roleFamily  String
  focusAreas  String[]
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("PersonaCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
}

model CommunicationStressTest {
  id                   String       @id @default(uuid())
  tenantId             String
  tenant               Tenant       @relation(fields: [tenantId], references: [id])
  createdById          String
  idempotencyKey       String
  parentTestId         String?
  sourceType           SourceType
  title                String       @db.VarChar(160)
  message              String       @db.Text
  category             String?
  contentFingerprint   String
  status               TestStatus   @default(PENDING)
  overallFrictionScore Int?
  frictionBand         FrictionBand?
  dimensionScores      Json?
  rewriteMessage       String?      @db.Text
  rewriteMetadata      Json?
  modelVersion         String?
  promptVersion        String?
  scoringVersion       String?
  expiresAt            DateTime?
  redactedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  reactions CommunicationPersonaReaction[]
  events    CommunicationStressTestEvent[]

  @@unique([tenantId, createdById, idempotencyKey])
  @@index([tenantId, createdById])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model CommunicationPersonaReaction {
  id           String                  @id @default(uuid())
  tenantId     String
  stressTestId String
  stressTest   CommunicationStressTest @relation(fields: [stressTestId], references: [id], onDelete: Cascade)
  personaKey   String
  personaName  String
  summary      String?                 @db.Text
  concernTypes String[]
  maxSeverity  String?
  concerns     Json
  mitigations  Json?
  createdAt    DateTime                @default(now())

  @@unique([stressTestId, personaKey])
  @@index([tenantId, stressTestId])
}

model CommunicationStressTestEvent {
  id           String                  @id @default(uuid())
  tenantId     String
  stressTestId String
  stressTest   CommunicationStressTest @relation(fields: [stressTestId], references: [id], onDelete: Cascade)
  actorId      String?
  eventType    String
  metadata     Json?
  createdAt    DateTime                @default(now())

  @@index([tenantId, stressTestId])
}

